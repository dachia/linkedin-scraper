{
  "manifest_version": 2,
  "name": "LinkedIn Profile Downloader",
  "version": "1.0",
  "description": "Download LinkedIn profiles as CSV",
  "permissions": [
    "activeTab",
    "cookies",
    "https://www.linkedin.com/*",
    "http://localhost:8000/*"
  ],
  "browser_action": {
    "default_popup": "src/popup.html"
  },
  "background": {
    "scripts": ["src/background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["src/content.js"]
    }
  ]
}
